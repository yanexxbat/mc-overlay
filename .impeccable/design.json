      "html": "<nav class=\"ds-categories\" aria-label=\"Categories\"><button class=\"ds-category ds-category-selected\" aria-current=\"page\">Combat</button><button class=\"ds-category\">Visuals</button><button class=\"ds-category\">Blocks</button></nav>",
      "css": ".ds-categories{display:flex;flex-direction:column;gap:6px;width:146px}.ds-category{font:500 14px Inter,sans-serif;color:#F3F4FF;background:rgba(192,207,255,.04);padding:7px 4px;height:40px;border:0;border-radius:10px}.ds-category-selected{background:rgba(129,140,248,.36)}.ds-category:hover{background:rgba(192,207,255,.21)}.ds-category:active{background:rgba(129,140,248,.50)}.ds-category:focus-visible{outline:2px solid #B2B9FF;outline-offset:2px}"
    },
    {
      "name": "Module tile",
      "kind": "button",
      "refersTo": "module-tile",
      "description": "Static translation of a genuine toggle tile: left-click toggles and right-click opens or raises independent settings. Native tiles show actual state and available binding.",
      "html": "<button class=\"ds-module ds-module-enabled\" aria-pressed=\"true\"><strong>Kill Aura</strong><span class=\"ds-module-state\">Enabled</span><span class=\"ds-module-binding\">Key: Unbound</span></button>",
      "css": ".ds-module{position:relative;display:block;width:210px;height:96px;text-align:left;font:500 14px Inter,sans-serif;color:#F3F4FF;background:rgba(192,207,255,.065);border:1px solid rgba(192,207,255,.10);border-radius:12px;padding:0}.ds-module strong{position:absolute;left:14px;top:16px;font-weight:600}.ds-module-state{position:absolute;left:28px;top:41px;color:#D7DCEC}.ds-module-state:before{content:\"\";position:absolute;left:-13px;top:5px;width:6px;height:6px;border-radius:50%;background:rgba(215,220,236,.65)}.ds-module-binding{position:absolute;left:14px;top:69px;color:#D7DCEC}.ds-module-enabled{background:rgba(129,140,248,.22);border-color:rgba(178,185,255,.38)}.ds-module-enabled .ds-module-state:before{background:#98DEC3}.ds-module:hover{background:rgba(192,207,255,.14)}.ds-module-enabled:hover,.ds-module-enabled:active{background:rgba(129,140,248,.32)}.ds-module:focus-visible{outline:2px solid #B2B9FF;outline-offset:0}"
    },
