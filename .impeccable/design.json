  "narrative": {
    "northStar": "Compact Translucent Controls",
    "overview": "The client follows the user's `design/reference-translucent-menu.png`: a wide, compact anthracite menu with a narrow sidebar, module tabs and a muted coral accent. The user approved this design and requested the same system on the injector and snapshot HUD. This replaces the spacious cyan example, the client's glass tile grid and the launcher's lavender Liquid Glass presentation. The reference supplies visual direction; mcov retains its real module names, settings and actions.\n\nClient controls, injector and HUD editor use direct ImGui alpha compositing, scoped `CompactStyle`, embedded Inter and modest headings. Snapshot HUDs share the drawing tokens and font. The client organizes module settings; the injector organizes instance selection and diagnostics. The shared palette and controls keep these operations consistent. World effects retain their styles.",
    "keyCharacteristics": [
      "Shared compact anthracite roots with restrained coral interaction states.",
      "Seven categories, searchable module tabs and settings within one window.",
      "Native keyboard input, visible slider values and real module state.",
      "Local style/font ownership and direct transparency without backdrop capture.",
      "Start/Diagnose navigation with a fixed launcher action and close footer."
    ],
    "rules": [
      {
        "name": "The Material Scope Rule",
        "body": "Client, injector and snapshot HUD use the same compact palette and direct alpha compositing. World effects retain their styles.",
        "section": "colors"
      },
      {
        "name": "The Local Type Rule",
        "body": "Both surfaces use `CompactStyle` to push their menu font and restore the prior style and font on scope exit. The HUD editor uses the same scope; snapshot HUD rendering pushes and restores the shared `MenuFont` locally.",
        "section": "typography"
      },
      {
        "name": "The Layer Order Rule",
        "body": "World effects and HUD draw before client controls. UI presentation adds no render-thread JNI and does not replace world-depth handling.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use scoped `CompactStyle` for client, injector and HUD editor controls.",
      "**Do** preserve real module names, section identities, keybinds and native input behavior.",
      "**Do** keep module tabs outside content scroll and provide search recovery.",
      "**Do** keep the launcher primary action and close footer outside scrolling content.",
      "**Do** report direct client transparency and preserve its configured capture preference."
    ],
    "donts": [
      "**Don't** reintroduce the rejected spacious cyan client or large module tile grid.",
      "**Don't** describe compact client, injector or HUD transparency as live desktop capture or Liquid Glass blur.",
      "**Don't** restyle world ESP/effects or add render-thread JNI during compact UI work.",
      "**Don't** require loose shader/font/DLL files beside the portable EXE.",
      "**Don't** claim synthetic WARP images validate live Minecraft appearance or attach behavior."
    ]
  }
