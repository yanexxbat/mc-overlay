  "components": [
    {
      "name": "Compact button",
      "kind": "button",
      "refersTo": "button",
      "description": "Visual translation of native compact button states; small footer actions use the same palette.",
      "html": "<button class=\"ds-button\">Center</button>",
      "css": ".ds-button{font:500 14px Inter,sans-serif;color:#ECECEF;background:rgba(255,255,255,.045);border:0;border-radius:4px;padding:3px 7px}.ds-button:hover{background:rgba(255,255,255,.09)}.ds-button:active{background:rgba(239,139,112,.18)}.ds-button:focus-visible{outline:1px solid #FFA388;outline-offset:1px}"
    },
    {
      "name": "Search and numeric input",
      "kind": "input",
      "refersTo": "input",
      "description": "Native search and Ctrl-click numeric entry share compact dark field styling; this is a visual web translation.",
      "html": "<input class=\"ds-input\" aria-label=\"Search modules\" placeholder=\"Search\">",
      "css": ".ds-input{font:500 14px Inter,sans-serif;color:#ECECEF;background:rgba(255,255,255,.045);padding:3px 7px;border:0;border-radius:4px;width:122px}.ds-input::placeholder{color:#AEAEB8}.ds-input:hover{background:rgba(255,255,255,.085)}.ds-input:focus-visible{background:rgba(255,255,255,.12);outline:1px solid #FFA388;outline-offset:1px}"
    },
    {
      "name": "Category sidebar",
      "kind": "nav",
      "refersTo": "category-navigation",
      "description": "Shared native navigation: client sidebar 150px, injector 142px, both 112px below their 620px root/viewport threshold. Selected rows use warm text and authored coral line icons.",
      "html": "<nav class=\"ds-categories\" aria-label=\"Categories\"><button class=\"ds-category ds-category-selected\" aria-current=\"page\"><svg viewBox=\"0 0 20 20\" aria-hidden=\"true\"><circle cx=\"10\" cy=\"10\" r=\"5.5\"/><path d=\"M2 10h16M10 2v16\"/></svg>Combat</button><button class=\"ds-category\">Visuals</button><button class=\"ds-category\">Blocks</button></nav>",
      "css": ".ds-categories{display:flex;flex-direction:column;gap:6px;width:130px;padding:10px;background:rgba(21,21,27,.22)}.ds-category{position:relative;text-align:left;font:500 14px Inter,sans-serif;color:#C2C2CC;background:transparent;padding:4px 0 4px 32px;height:29px;border:0;border-radius:4px}.ds-category-selected{color:#F5D0C4;background:rgba(255,255,255,.065)}.ds-category svg{position:absolute;left:5px;top:4px;width:20px;height:20px;fill:none;stroke:#EF8B70;stroke-width:1.25}.ds-category:hover{background:rgba(255,255,255,.09)}.ds-category:active{background:rgba(239,139,112,.18)}.ds-category:focus-visible{outline:1px solid #FFA388;outline-offset:1px}"
    },
    {
      "name": "Module tabs",
      "kind": "nav",
      "refersTo": "module-tab",
      "description": "Tabs select real module settings inside the main window. Selection does not toggle the module; native overflow arrows provide horizontal scrolling.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\" aria-label=\"Combat modules\"><button class=\"ds-tab ds-tab-selected\" role=\"tab\" aria-selected=\"true\">Kill Aura</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\">Aim Assist</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\">Friends</button></div>",
      "css": ".ds-tabs{display:flex;gap:4px;width:330px;overflow:auto}.ds-tab{font:500 14px Inter,sans-serif;color:#ECECEF;background:rgba(255,255,255,.035);padding:3px 7px;border:0;border-radius:5px 5px 0 0;white-space:nowrap}.ds-tab-selected{background:rgba(239,139,112,.16)}.ds-tab:hover{background:rgba(255,255,255,.09)}.ds-tab:active{background:rgba(239,139,112,.18)}.ds-tab:focus-visible{outline:1px solid #FFA388;outline-offset:-1px}"
    },
    {
      "name": "Checkbox row",
      "kind": "input",
      "description": "Label and real native checkbox occupy separate columns; clicking the label toggles the value. Quick toggles use this row pattern.",
      "html": "<label class=\"ds-check-row\"><span>Auto Totem</span><input class=\"ds-check\" type=\"checkbox\" checked></label>",
      "css": ".ds-check-row{display:flex;align-items:center;justify-content:space-between;width:260px;gap:12px;font:500 14px Inter,sans-serif;color:#ECECEF;padding:4px 3px}.ds-check{appearance:none;position:relative;width:20px;height:20px;margin:0;border:0;border-radius:4px;background:rgba(255,255,255,.045)}.ds-check:hover{background:rgba(255,255,255,.085)}.ds-check:active{background:rgba(255,255,255,.12)}.ds-check:checked:after{content:\"\";position:absolute;left:6px;top:3px;width:6px;height:11px;border:solid #EF8B70;border-width:0 2px 2px 0;transform:rotate(45deg)}.ds-check:focus-visible{outline:1px solid #FFA388;outline-offset:1px}"
    },
    {
      "name": "Filled native slider",
      "kind": "custom",
      "description": "Visual translation of compact coral fill and centered dark value lozenge. Production uses ImGui SliderScalar with mouse/keyboard input and visible Ctrl-click direct entry.",
      "html": "<div class=\"ds-slider-row\"><span>Reach</span><div class=\"ds-slider-frame\" role=\"slider\" aria-label=\"Reach\" aria-valuemin=\"1\" aria-valuemax=\"6\" aria-valuenow=\"3\" tabindex=\"0\"><span class=\"ds-slider-fill\"></span><span class=\"ds-slider-value\">3.0 m</span></div></div>",
      "css": ".ds-slider-row{display:flex;align-items:center;justify-content:space-between;gap:16px;width:320px;font:500 14px Inter,sans-serif;color:#ECECEF}.ds-slider-frame{position:relative;width:160px;height:23px;border-radius:4px;background:rgba(255,255,255,.045)}.ds-slider-fill{position:absolute;inset:0 auto 0 0;width:40%;border-radius:4px;background:#EF8B70}.ds-slider-value{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);padding:0 4px;border-radius:3px;background:rgba(37,37,44,.72);white-space:nowrap}.ds-slider-frame:hover{background:rgba(255,255,255,.085)}.ds-slider-frame:active .ds-slider-fill{background:#FFA388}.ds-slider-frame:focus-visible{outline:1px solid #FFA388;outline-offset:0}"
    },
    {
      "name": "Content surface",
      "kind": "card",
      "refersTo": "content-panel",
      "description": "Transparent scrolling content within the same client root; there is no separate settings window or inset glass material.",
      "html": "<section class=\"ds-content\"><strong>Aim Assist</strong><hr><p>Existing module settings</p></section>",
      "css": ".ds-content{font:500 14px Inter,sans-serif;color:#ECECEF;background:transparent;border-radius:8px;width:260px}.ds-content strong{font-weight:600}.ds-content hr{border:0;border-top:1px solid rgba(255,255,255,.065);margin:8px 0}.ds-content p{color:#AEAEB8;margin:6px 0 0}"
    },
    {
      "name": "Compact client root",
      "kind": "custom",
      "refersTo": "client-root",
