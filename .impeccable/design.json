      "css": ".ds-panel{font:500 14px Inter,sans-serif;color:#F3F4FF;background:rgba(16,21,34,.24);border-radius:14px;padding:13px;width:270px}.ds-panel strong{font-weight:600}.ds-panel p{color:#D7DCEC;margin:8px 0 0}"
    },
    {
      "name": "Slider",
      "kind": "input",
      "description": "Visual-only translation of the native thin rail, pale grab and separate value label.",
      "html": "<label class=\"ds-slider-label\">Reach <span>3.0 m</span><input class=\"ds-slider\" aria-label=\"Reach slider\" type=\"range\" min=\"1\" max=\"6\" value=\"3\"></label>",
      "css": ".ds-slider-label{display:block;width:250px;font:500 14px Inter,sans-serif;color:#F3F4FF}.ds-slider-label span{float:right;color:#B2B9FF}.ds-slider{appearance:none;display:block;width:100%;height:4px;margin:12px 0;background:rgba(200,213,255,.13);border-radius:2px}.ds-slider::-webkit-slider-thumb{appearance:none;width:11px;height:11px;border-radius:50%;background:#EDF0FF}.ds-slider::-moz-range-thumb{width:11px;height:11px;border:0;border-radius:50%;background:#EDF0FF}.ds-slider:hover::-webkit-slider-thumb{box-shadow:0 0 0 4px rgba(178,185,255,.09)}.ds-slider:focus-visible{outline:2px solid #B2B9FF;outline-offset:6px}"
    },
    {
      "name": "Glass root",
      "kind": "custom",
      "description": "Static approximation of the shared root/settings material; each native window has an independent retained pane image. Live blur/refraction is native D3D11, not this CSS.",
      "html": "<section class=\"ds-glass\"><strong>mcov</strong><p>Liquid glass</p></section>",
      "css": ".ds-glass{font:500 14px Inter,sans-serif;color:#F3F4FF;width:260px;padding:16px;border-radius:22px;background:rgba(25,32,51,.98);border:1px solid rgba(210,222,255,.18);box-shadow:0 9px 20px rgba(0,0,0,.22)}.ds-glass strong{font-size:22.1px;font-weight:600}.ds-glass p{margin:8px 0 0;color:#D7DCEC}"
    },
    {
      "name": "Independent settings window",
      "kind": "custom",
      "description": "Static native-window approximation, up to 480x610 and viewport-clamped. Position and close are independent; category changes preserve selected module and scroll. Different module selection resets scroll; the same module is raised without resetting it.",
      "html": "<section class=\"ds-settings\"><header class=\"ds-settings-header\"><strong>Kill Aura</strong><button class=\"ds-settings-close\" aria-label=\"Close settings\">X</button></header><div class=\"ds-settings-content\"><span>Enable Kill Aura</span><p>Existing module controls</p></div></section>",
      "css": ".ds-settings{font:500 14px Inter,sans-serif;color:#F3F4FF;width:320px;border-radius:22px;background:rgba(25,32,51,.98);border:1px solid rgba(210,222,255,.18);box-shadow:0 9px 20px rgba(0,0,0,.22);padding:16px}.ds-settings-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}.ds-settings-header strong{font-size:22.1px;font-weight:600}.ds-settings-close{font:500 14px Inter,sans-serif;color:#F3F4FF;background:rgba(192,207,255,.10);border:0;border-radius:8px;width:27px;height:27px}.ds-settings-close:hover{background:rgba(192,207,255,.21)}.ds-settings-close:active{background:rgba(129,140,248,.50)}.ds-settings-close:focus-visible{outline:2px solid #B2B9FF;outline-offset:2px}.ds-settings-content{background:rgba(16,21,34,.24);border-radius:14px;padding:13px;max-height:180px;overflow:auto}.ds-settings-content p{color:#D7DCEC;margin:8px 0 0}"
    }
  ],
  "narrative": {
    "northStar": "Liquid Glass",
    "overview": "Mode: Operate. The user's latest visual authority is\n[poncippg-spec/liquidDX11](https://github.com/poncippg-spec/liquidDX11), replacing\nthe earlier classic dark/violet menu. This system describes the implemented\nnative Windows control surface, not a web dashboard or a copy of the reference\ndemo's content.\n\nA dark, neutral-tinted glass root provides blur, restrained refraction and subtle\nlight edges. Crisp Inter text and quiet translucent controls keep real settings\nreadable over changing game imagery. The client menu and launcher share this\nmaterial; existing world effects, entity ESP and modular HUD retain their own\nvisuals and behavior.",
    "keyCharacteristics": [
      "A softly rounded glass root with calmer, inset setting surfaces.",
      "Seven left-side categories, a responsive module grid and independent settings glass.",
      "Visible values, conventional checkbox interaction and keyboard-editable sliders.",
      "A primary launcher action that remains outside its scrolling details.",
      "Scoped style/font changes and a deterministic capture fallback."
    ],
    "rules": [
      {
        "name": "The Readable Glass Rule",
        "body": "Root refraction and blur remain behind text and controls. Dense settings use the darker inset content surface; they do not inherit a more transparent root merely to emphasize the effect.",
        "section": "colors"
      },
      {
        "name": "The Local Type Rule",
        "body": "`LiquidStyle` pushes the menu font and restores it on scope exit. Do not change global font defaults to restyle the menu or launcher.",
        "section": "typography"
      },
      {
        "name": "The Layer Order Rule",
        "body": "World effects and HUD precede the menu glass; controls and text follow it. `RenderTexture()` plus the root's `AddImage` retain this order. Each window's own image retains that order when windows overlap. The glass pass introduces no JVM calls and does not replace world-depth handling.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** reuse the shared glass root and scoped `LiquidStyle` for client controls.",
      "**Do** preserve real module names, section identities, keybinds and input behavior.",
      "**Do** keep the launcher start action outside scrolling content.",
      "**Do** keep HUD/ESP rendering styles and JNI acquisition separate from menu material.",
      "**Do** report live versus fallback material and the actual Background capture state under Settings → Overlay."
    ],
    "donts": [
      "**Don't** globally replace the HUD/ESP style or fonts during a menu redesign.",
      "**Don't** capture an unexcluded glass window into its own backdrop.",
      "**Don't** require loose shader/font/DLL files beside the portable EXE.",
      "**Don't** claim offscreen WARP previews validate live Minecraft capture on every GPU.",
      "**Don't** reintroduce reference-demo controls as placeholders for mcov modules."
    ]
  }
}
