# Der portable Launcher enthaelt ausschliesslich fertig gebaute Runtime-Artefakte.
set(names "mcov_overlay.exe" "mcov_agent.dll" "tools/AgentLoader.class" "tools/frame-sync-agent.jar" "tools/frame-signal.jar")
set(paths "${OVERLAY}" "${AGENT}" "${LOADER}" "${FRAME}" "${SIGNAL}")
set(rc "#include <windows.h>\n")
set(header "// Generated payload manifest.\n#pragma once\nstruct Payload { int id; const char* name; const char* sha; };\ninline constexpr Payload kPayloads[] = {\n")
set(hashes "")
foreach(i RANGE 0 4)
    list(GET names ${i} name)
    list(GET paths ${i} path)
    file(SHA256 "${path}" hash)
    math(EXPR id "5000+${i}")
    string(APPEND hashes "${hash}")
    string(APPEND rc "${id} RCDATA \"${path}\"\n")
    string(APPEND header "    {${id}, \"${name}\", \"${hash}\"},\n")
endforeach()
string(SHA256 package_id "${hashes}")
string(SUBSTRING "${package_id}" 0 20 package_id)
string(APPEND header "};\ninline constexpr char kPackageId[]=\"${package_id}\";\n")
file(WRITE "${OUTPUT_RC}" "${rc}")
file(WRITE "${OUTPUT_HEADER}" "${header}")
